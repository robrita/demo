# Optional defaults for test generation.
# Copy this file to .env and fill in the values you want to use locally.

PROJECT_DIR=.
SOURCE_FILE=src/math_utils.py
OUTPUT_FILE=tests/test_math_utils.py
OVERWRITE_OUTPUT=false

# Select which GitHub Copilot SDK path to use: default Copilot auth or a Foundry custom provider.
MODEL_PROVIDER=copilot

COPILOT_MODEL=gpt-5

# Optional GitHub token passed directly to the Copilot SDK.
GITHUB_TOKEN=your-github-token

# Microsoft Foundry settings used through the GitHub Copilot SDK custom provider.
# For Azure-compatible endpoints, use FOUNDRY_PROVIDER_TYPE=azure and set the host URL only.
# For other OpenAI-compatible endpoints, use FOUNDRY_PROVIDER_TYPE=openai and include the full base URL.
FOUNDRY_MODEL_NAME=gpt-4.1
FOUNDRY_BASE_URL=https://your-resource.openai.azure.com
FOUNDRY_API_KEY=replace-with-foundry-api-key
FOUNDRY_PROVIDER_TYPE=azure
FOUNDRY_WIRE_API=completions
FOUNDRY_API_VERSION=2024-10-21

# Debugging and timeout controls.
GENERATION_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
LOG_COPILOT_EVENTS=false